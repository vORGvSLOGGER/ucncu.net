# ============================================================
#  UCNCU.NET — متغيرات الطور الحقيقي (Real Mode / Online)
#  انسخ هذا الملف إلى .env.local للتطوير المحلي،
#  وأضف نفس القيم كـ GitHub Repository Secrets للنشر.
#  بدون هذه القيم تعمل اللعبة بالطور التجريبي فقط (بأمان تام).
# ============================================================

# من Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# اختياري: إيميلات الإدارة العليا (مفصولة بفواصل)
# مثال: admin@ucncu.net,owner@ucncu.net
NEXT_PUBLIC_ADMIN_EMAILS=

# مسار النشر على GitHub Pages (اتركه كما هو ما لم تربط نطاقًا مخصصًا)
NEXT_PUBLIC_BASE_PATH=/ucncu.net
